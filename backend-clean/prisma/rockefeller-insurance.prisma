// Rockefeller Whole Life Insurance Policy Schema
// Reference Number: 123456789

// Datasource moved to prisma.config.ts

model RockefellerPolicyHolder {
  id                   String   @id @default(cuid())
  referenceNumber      String   @default("123456789")
  firstName            String
  lastName             String
  email                String   @unique
  phoneNumber          String
  dateOfBirth          DateTime
  address              String
  city                 String
  state                String
  zipCode              String
  country              String   @default("USA")
  socialSecurityNumber String   @unique
  occupation           String
  annualIncome         Float
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  policies      WholeLifePolicy[]
  beneficiaries Beneficiary[]

  @@map("rockefeller_policy_holders")
}

model WholeLifePolicy {
  id                    String           @id @default(cuid())
  policyNumber          String           @unique
  policyHolderId        String
  referenceNumber       String           @default("123456789")
  policyType            String           @default("WHOLE_LIFE")
  coverageAmount        Float
  premiumAmount         Float
  paymentFrequency      String // MONTHLY, QUARTERLY, ANNUALLY
  cashValue             Float            @default(0)
  loanAmount            Float            @default(0)
  loanInterestRate      Float            @default(5.5)
  policyStatus          String           @default("ACTIVE") // ACTIVE, LAPSED, PAID_UP, SURRENDERED
  issueDate             DateTime
  maturityDate          DateTime
  premiumPaymentHistory PremiumPayment[]
  beneficiaries         Beneficiary[]
  claims                Claim[]
  riders                PolicyRider[]

  policyHolder RockefellerPolicyHolder @relation(fields: [policyHolderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("whole_life_policies")
}

model Beneficiary {
  id                   String   @id @default(cuid())
  policyId             String
  firstName            String
  lastName             String
  relationship         String
  percentage           Float
  dateOfBirth          DateTime
  socialSecurityNumber String
  contactInfo          String
  isContingent         Boolean  @default(false)

  policy WholeLifePolicy @relation(fields: [policyId], references: [id])

  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  rockefellerPolicyHolder   RockefellerPolicyHolder? @relation(fields: [rockefellerPolicyHolderId], references: [id])
  rockefellerPolicyHolderId String?

  @@map("beneficiaries")
}

model PremiumPayment {
  id              String   @id @default(cuid())
  policyId        String
  amount          Float
  paymentDate     DateTime
  paymentMethod   String // CREDIT_CARD, BANK_TRANSFER, CHECK
  paymentStatus   String   @default("PAID") // PAID, PENDING, FAILED
  dueDate         DateTime
  lateFee         Float    @default(0)
  referenceNumber String   @default("123456789")

  policy WholeLifePolicy @relation(fields: [policyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("premium_payments")
}

model Claim {
  id              String    @id @default(cuid())
  policyId        String
  claimNumber     String    @unique
  claimType       String // DEATH_BENEFIT, ACCIDENTAL_DEATH, DISABILITY
  claimStatus     String    @default("PENDING") // PENDING, APPROVED, DENIED, PAID
  claimAmount     Float
  claimDate       DateTime
  description     String
  supportingDocs  String // JSON array of document URLs
  adjusterNotes   String?
  settlementDate  DateTime?
  referenceNumber String    @default("123456789")

  policy WholeLifePolicy @relation(fields: [policyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("claims")
}

model PolicyRider {
  id                String    @id @default(cuid())
  policyId          String
  riderType         String // ACCIDENTAL_DEATH, WAIVER_OF_PREMIUM, LONG_TERM_CARE
  riderName         String
  coverageAmount    Float
  additionalPremium Float
  riderStatus       String    @default("ACTIVE")
  effectiveDate     DateTime
  expirationDate    DateTime?
  referenceNumber   String    @default("123456789")

  policy WholeLifePolicy @relation(fields: [policyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("policy_riders")
}

model RockefellerFamilyTrust {
  id              String    @id @default(cuid())
  trustName       String
  trustType       String    @default("FAMILY_TRUST")
  referenceNumber String    @default("123456789")
  trusteeName     String
  trusteeContact  String
  grantorName     String
  grantorContact  String
  trustValue      Float
  establishedDate DateTime
  terminationDate DateTime?
  policies        String // JSON array of policy IDs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("rockefeller_family_trusts")
}

model InsuranceAgent {
  id              String   @id @default(cuid())
  agentCode       String   @unique
  firstName       String
  lastName        String
  email           String   @unique
  phoneNumber     String
  licenseNumber   String
  licenseExpiry   DateTime
  commissionRate  Float    @default(0.15)
  agencyName      String
  isActive        Boolean  @default(true)
  referenceNumber String   @default("123456789")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("insurance_agents")
}
