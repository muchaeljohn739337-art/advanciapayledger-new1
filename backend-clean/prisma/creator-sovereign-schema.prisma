// ============================================================================  
// ADVANCIA PAY LEDGER - CREATOR'S SOVEREIGN SCHEMA
// Author: Original Creator - Complete Control
// Database: Local PostgreSQL - No External Access
// ============================================================================

// CREATOR'S DATABASE CONNECTION - DIRECT LOCALHOST
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://postgres:postgres@localhost:5432/advancia_payledger"
}

// ============================================================================
// CREATOR'S USER SYSTEM - NO EXTERNAL APPROVALS
// ============================================================================

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  password          String
  username          String?   @unique
  firstName         String?
  lastName          String?
  phone             String?
  role              UserRole  @default(USER)
  isActive          Boolean   @default(true)
  emailVerified     Boolean   @default(false)
  twoFactorEnabled  Boolean   @default(false)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // CREATOR'S RELATIONS - NO EXTERNAL CONTROLS
  wallet            Wallet?
  transactions      Transaction[]
  cryptoTransactions CryptoTransaction[]
  notifications      Notification[]
  protectionPlan    ProtectionPlan?
  medicalBookings   MedicalBooking[]
  virtualCards      VirtualCard[]
  
  @@map("users")
}

enum UserRole {
  USER             // Regular user
  DOCTOR           // Medical professional  
  MODERATOR        // Content moderator
  MEDICAL_STAFF    // Healthcare worker
  FACILITY_ADMIN   // Manages medical facility
  ADMIN            // Platform admin - CREATOR'S HIGHEST LEVEL
}

// ============================================================================
// CREATOR'S WALLET SYSTEM - MULTI-BLOCKCHAIN
// ============================================================================

model Wallet {
  id            String    @id @default(cuid())
  userId        String    @unique
  balance       Float     @default(0)
  earnings      Float     @default(0)
  referral      Float     @default(0)
  cryptoAddress String?
  
  // CREATOR'S BLOCKCHAIN ADDRESSES
  ethereumAddress  String? @unique
  polygonAddress   String? @unique
  bscAddress       String? @unique
  arbitrumAddress  String? @unique
  optimismAddress  String? @unique
  stellarAddress   String? @unique
  
  // ENCRYPTED PRIVATE KEYS - CREATOR'S ACCESS ONLY
  ethereumPrivateKey  String?
  polygonPrivateKey   String?
  bscPrivateKey       String?
  arbitrumPrivateKey  String?
  optimismPrivateKey  String?
  stellarPrivateKey   String?
  
  // CACHED BALANCES
  ethereumBalance  Float @default(0)
  polygonBalance   Float @default(0)
  bscBalance       Float @default(0)
  arbitrumBalance  Float @default(0)
  optimismBalance  Float @default(0)
  stellarBalance   Float @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("wallets")
}

// ============================================================================
// CREATOR'S TRANSACTION SYSTEM
// ============================================================================

model Transaction {
  id              String          @id @default(cuid())
  userId          String
  type            TransactionType
  amount          Float
  status          TransactionStatus @default(PENDING)
  description     String?
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("transactions")
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  PAYMENT
  REFUND
  TRANSFER
  SEND
  RECEIVE
  FEE
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// ============================================================================
// CREATOR'S CRYPTO TRANSACTION SYSTEM
// ============================================================================

model CryptoTransaction {
  id            String    @id @default(cuid())
  userId        String
  txHash        String    @unique
  fromAddress   String
  toAddress     String
  amount        String
  currency      String
  chain         String
  status        String    @default("pending")
  gasUsed       String?
  gasPrice      String?
  blockNumber   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("crypto_transactions")
}

// ============================================================================
// CREATOR'S PROTECTION PLAN - HOME EQUITY LINE OF CREDIT
// ============================================================================

model ProtectionPlan {
  id              String    @id @default(cuid())
  userId          String    @unique
  referenceNumber String    @unique @default("123456789") // CREATOR'S REFERENCE
  planType        PlanType  @default(HELOC)
  propertyAddress String
  propertyValue   Float
  helocAmount     Float
  status          String    @default("pending")
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("protection_plans")
}

enum PlanType {
  HELOC
  HOME_PROTECTION
  CREDIT_LINE
}

// ============================================================================
// CREATOR'S VIRTUAL CARD SYSTEM
// ============================================================================

model VirtualCard {
  id            String     @id @default(cuid())
  userId        String
  cardNumber    String     @unique
  expiryDate    String
  cvv           String
  cardHolder    String
  status        CardStatus @default(ACTIVE)
  limit         Float      @default(10000)
  balance       Float      @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("virtual_cards")
}

enum CardStatus {
  ACTIVE
  FROZEN
  EXPIRED
  CANCELLED
}

// ============================================================================
// CREATOR'S NOTIFICATION SYSTEM
// ============================================================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("notifications")
}

enum NotificationType {
  SYSTEM
  TRANSACTION
  APPROVAL
  SECURITY
  MARKETING
  ALERT
}

// ============================================================================
// CREATOR'S MEDICAL SYSTEM
// ============================================================================

model MedicalFacility {
  id          String   @id @default(cuid())
  name        String
  address     String
  city        String
  state       String
  zipCode     String
  phone       String
  email       String
  type        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("medical_facilities")
}

model MedicalBooking {
  id              String        @id @default(cuid())
  userId          String
  facilityId      String
  doctorId        String?
  service         String
  date            DateTime
  duration        Int           @default(60) // minutes
  status          BookingStatus @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  user User @relation(fields: [userId], references: [id])
  
  @@map("medical_bookings")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

// ============================================================================
// CREATOR'S SYSTEM CONFIGURATION
// ============================================================================

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("system_config")
}

// ============================================================================
// CREATOR'S AUDIT SYSTEM
// ============================================================================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  details     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  
  @@map("audit_logs")
}

// ============================================================================
// CREATOR'S BLOCKCHAIN SYSTEM
// ============================================================================

model BlockchainTransaction {
  id          String   @id @default(cuid())
  txHash      String   @unique
  chain       String
  fromAddress String
  toAddress   String
  amount      String
  status      String   @default("pending")
  blockNumber String?
  gasUsed     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("blockchain_transactions")
}

model SmartContract {
  id          String   @id @default(cuid())
  address     String   @unique
  chain       String
  name        String
  abi         Json?
  deployedAt  DateTime @default(now())
  
  @@map("smart_contracts")
}
