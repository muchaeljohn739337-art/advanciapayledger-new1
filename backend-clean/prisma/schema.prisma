// ============================================================================
// ADVANCIA PAY LEDGER - PRODUCTION DATABASE SCHEMA
// Launch Date: January 14, 2026
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Datasource moved to prisma.config.ts

// ============================================================================
// USER MANAGEMENT - WITH ADMIN APPROVAL SYSTEM
// ============================================================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  phone     String?
  
  // CRITICAL: Admin Approval System
  status    UserStatus @default(PENDING_APPROVAL)
  approvedBy String?  // Admin ID who approved
  approvedAt DateTime?
  rejectedBy String?
  rejectedAt DateTime?
  rejectionReason String?
  
  // Auto-approval tracking
  registeredAt DateTime @default(now())
  autoApproved Boolean @default(false)
  
  role      UserRole @default(USER)
  
  // Verification
  emailVerified Boolean @default(false)
  emailVerificationToken String?
  
  // KYC
  kycStatus KYCStatus @default(NOT_STARTED)
  kycSubmittedAt DateTime?
  kycApprovedAt DateTime?
  
  // HELOC Relations
  helocApplications HELOCApplication[]
  helocAccounts HELOCAccount[]
  helocDraws HELOCDraw[]
  helocRepayments HELOCRepayment[]
  helocRiskAssessments HELOCRiskAssessment[]
  helocNotifications HELOCNotification[]
  helocSettings HELOCSettings?
  
  // Whole Life Insurance Relations
  wholeLifePolicies WholeLifePolicy[]
  policyBeneficiaries PolicyBeneficiary[]
  policyRiders PolicyRider[]
  cancelTransactions CancelTransaction[]
  
  // Relations
  wallet    Wallet?
  cards     VirtualCard[]
  transactions Transaction[]
  appointments Appointment[]
  bookings  MedicalBooking[]
  notifications Notification[]
  
  // Rockefeller Protection Plan & HELOC Relations
  protectionPlan ProtectionPlan?
  
  // Additional relations for missing properties
  twoFactorSecret String?
  twoFactorEnabled Boolean @default(false)
  lastLoginAt DateTime?
  isActive Boolean @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([email])
  @@index([status])
  @@index([role])
  @@index([registeredAt]) // For auto-approval cron
}

enum UserStatus {
  PENDING_APPROVAL  // Waiting for admin approval
  ACTIVE            // Approved and can use platform
  REJECTED          // Admin rejected
  SUSPENDED         // Admin suspended
  DELETED           // Soft deleted
}

enum UserRole {
  USER              // Regular user
  DOCTOR            // Medical professional
  MODERATOR         // Content moderator
  MEDICAL_STAFF     // Healthcare worker
  FACILITY_ADMIN    // Manages medical facility
  ADMIN             // Platform admin (highest level)
}

enum KYCStatus {
  NOT_STARTED
  DOCUMENTS_UPLOADED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESUBMIT_REQUIRED
}

// ============================================================================
// WALLET SYSTEM - MULTI-BLOCKCHAIN
// ============================================================================

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Blockchain addresses
  ethereumAddress  String @unique
  polygonAddress   String @unique
  bscAddress       String @unique
  arbitrumAddress  String @unique
  optimismAddress  String @unique
  stellarAddress   String @unique
  
  // Private keys (ENCRYPTED in production)
  ethereumPrivateKey  String
  polygonPrivateKey   String
  bscPrivateKey       String
  arbitrumPrivateKey  String
  optimismPrivateKey  String
  stellarPrivateKey   String
  
  // Balances (cached from blockchain)
  ethereumBalance  Float @default(0)
  polygonBalance   Float @default(0)
  bscBalance       Float @default(0)
  arbitrumBalance  Float @default(0)
  optimismBalance  Float @default(0)
  stellarBalance   Float @default(0)
  
  // Additional balance field for compatibility
  balance Float @default(0)
  
  // Additional crypto address field
  cryptoAddress String?
  
  usdValue         Float @default(0)
  
  lastSyncedAt     DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  // Relations for legacy code compatibility
  cryptoDeposits   CryptoDeposit[]
  transactions     Transaction[]
  
  @@index([userId])
}

// ============================================================================
// VIRTUAL CARDS
// ============================================================================

model VirtualCard {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  cardNumber    String   @unique
  cardholderName String
  expiryMonth   Int
  expiryYear    Int
  cvv           String
  
  balance       Float  @default(0)
  currency      String   @default("USD")
  
  status        CardStatus @default(ACTIVE)
  
  // Additional fields for compatibility
  stripeCardId String?
  expiryDate String? // Combined expiry for compatibility
  last4 String? // Last 4 digits for compatibility
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([userId])
  @@index([status])
}

enum CardStatus {
  ACTIVE
  FROZEN
  EXPIRED
  CANCELLED
  active
  frozen
  expired
  cancelled
}

// ============================================================================
// TRANSACTIONS
// ============================================================================

model Transaction {
  id              String   @id @default(cuid())
  userId          String
  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet          Wallet?  @relation(fields: [walletId], references: [id])
  
  type            TransactionType
  amount          Float
  currency        String   @default("USD")
  
  // Blockchain details
  chain           String?  // ethereum, polygon, bsc, etc.
  txHash          String?  @unique
  fromAddress     String?
  toAddress       String?
  gasUsed         Float?
  gasFee          Float?
  
  status          TransactionStatus @default(PENDING)
  
  // Additional fields for compatibility
  method String?
  walletId String?
  
  description     String?
  metadata        Json?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  SEND
  RECEIVE
  PAYMENT
  REFUND
  FEE
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// ============================================================================
// MEDICAL FACILITIES & BOOKINGS
// ============================================================================

model MedicalFacility {
  id          String   @id @default(cuid())
  name        String
  address     String
  city        String
  state       String
  zipCode     String
  phone       String
  email       String?
  
  // Bed availability (real-time)
  generalBeds     Int @default(0)
  icuBeds         Int @default(0)
  emergencyBeds   Int @default(0)
  maternityBeds   Int @default(0)
  pediatricBeds   Int @default(0)
  surgicalBeds    Int @default(0)
  
  // Available beds
  generalAvailable     Int @default(0)
  icuAvailable         Int @default(0)
  emergencyAvailable   Int @default(0)
  maternityAvailable   Int @default(0)
  pediatricAvailable   Int @default(0)
  surgicalAvailable    Int @default(0)
  
  // Pricing (USD per day)
  generalPrice     Float
  icuPrice         Float
  emergencyPrice   Float
  maternityPrice   Float
  pediatricPrice   Float
  surgicalPrice    Float
  
  acceptsCrypto    Boolean @default(true)
  acceptsFiat      Boolean @default(false)
  
  // Additional fields for compatibility
  isActive Boolean @default(true)
  contactPerson String?
  
  bookings         MedicalBooking[]
  appointments     Appointment[]
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  @@index([city, state])
}

model MedicalBooking {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  facilityId      String
  facility        MedicalFacility @relation(fields: [facilityId], references: [id])
  
  bedType         BedType
  patientName     String
  patientAge      Int
  condition       String
  
  checkInDate     DateTime
  checkOutDate    DateTime
  durationDays    Int
  
  pricePerDay     Float
  totalCost       Float
  
  paymentMethod   String   // crypto or fiat
  paymentCurrency String?  // ETH, USDT, USD, etc.
  paymentTxHash   String?
  paymentStatus   PaymentStatus @default(PENDING)
  
  status          BookingStatus @default(PENDING)
  
  confirmationNumber String @unique
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([userId])
  @@index([facilityId])
  @@index([status])
}

enum BedType {
  GENERAL
  ICU
  EMERGENCY
  MATERNITY
  PEDIATRIC
  SURGICAL
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

// ============================================================================
// APPOINTMENTS
// ============================================================================

model Appointment {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  facilityId      String
  facility        MedicalFacility @relation(fields: [facilityId], references: [id])
  
  patientName     String
  patientPhone    String
  department      String
  doctorName      String?
  
  appointmentDate DateTime
  appointmentTime String
  
  reason          String
  notes           String?
  
  cost            Float
  paymentStatus   PaymentStatus @default(PENDING)
  paymentTxHash   String?
  
  status          AppointmentStatus @default(SCHEDULED)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([userId])
  @@index([facilityId])
  @@index([appointmentDate])
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ============================================================================
// ADMIN SYSTEM
// ============================================================================

model AdminAction {
  id          String   @id @default(cuid())
  adminId     String
  adminEmail  String
  
  action      AdminActionType
  targetId    String?  // User ID, transaction ID, etc.
  targetType  String?  // user, transaction, booking, etc.
  
  details     Json?
  ipAddress   String?
  
  createdAt   DateTime @default(now())
  
  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

enum AdminActionType {
  APPROVE_USER
  REJECT_USER
  APPROVE_WITHDRAWAL
  REJECT_WITHDRAWAL
  SUSPEND_USER
  ACTIVATE_USER
  UPDATE_BALANCE
  MANUAL_TRANSACTION
  SYSTEM_CONFIG
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type      NotificationType
  title     String
  message   String
  link      String?
  
  read      Boolean  @default(false)
  
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

enum NotificationType {
  SYSTEM
  TRANSACTION
  APPROVAL
  BOOKING
  APPOINTMENT
  PAYMENT
  SECURITY
  SECURITY_ALERT
}

// ============================================================================
// EMAIL LOGS (For tracking Resend emails)
// ============================================================================

model EmailLog {
  id          String   @id @default(cuid())
  to          String
  subject     String
  template    String
  
  resendId    String?  // Resend email ID
  status      EmailStatus @default(SENT)
  
  sentAt      DateTime @default(now())
  openedAt    DateTime?
  clickedAt   DateTime?
  
  @@index([to])
  @@index([template])
  @@index([sentAt])
}

enum EmailStatus {
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  FAILED
}

// ============================================================================
// SYSTEM CONFIG (For maintenance mode, etc.)
// ============================================================================

model SystemConfig {
  id              String   @id @default(cuid())
  key             String   @unique
  value           String
  description     String?
  
  updatedBy       String?  // Admin ID
  updatedAt       DateTime @updatedAt
  
  @@index([key])
}

// ============================================================================
// MISSING MODELS FOR COMPATIBILITY
// ============================================================================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  adminId     String?
  action      String
  details     Json?
  ipAddress   String?
  userAgent   String?
  
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

model UserActivityLog {
  id          String   @id @default(cuid())
  userId      String
  activity    String
  details     Json?
  ipAddress   String?
  userAgent   String?
  
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([activity])
  @@index([createdAt])
}

model FraudDetectionLog {
  id          String   @id @default(cuid())
  userId      String?
  transactionId String?
  riskScore   Float
  riskFactors Json?
  action      String
  details     Json?
  
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([transactionId])
  @@index([riskScore])
  @@index([createdAt])
}

model BlockchainTransaction {
  id          String   @id @default(cuid())
  txHash      String   @unique
  chain       String
  fromAddress String
  toAddress   String
  amount      Float
  gasUsed     Float?
  gasFee      Float?
  status      String
  blockNumber Int?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([txHash])
  @@index([chain])
  @@index([fromAddress])
  @@index([toAddress])
  @@index([status])
}

model SmartContract {
  id          String   @id @default(cuid())
  address     String
  chain       String
  name        String?
  abi         Json?
  deployedAt  DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([address])
  @@index([chain])
}

model CryptoDeposit {
  id          String   @id @default(cuid())
  userId      String
  walletId    String?
  chain       String
  txHash      String   @unique
  fromAddress String
  toAddress   String
  amount      Float
  currency    String
  confirmations Int @default(0)
  status      String
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  wallet      Wallet?  @relation(fields: [walletId], references: [id])
  
  @@index([userId])
  @@index([walletId])
  @@index([txHash])
  @@index([status])
}

model Withdrawal {
  id          String   @id @default(cuid())
  userId      String
  amount      Float
  currency    String
  chain       String?
  toAddress   String
  status      String
  adminId     String?
  processedAt DateTime?
  txHash      String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model MedBedBooking {
  id          String   @id @default(cuid())
  userId      String
  facilityId  String
  bedType     String
  checkInDate DateTime
  checkOutDate DateTime
  totalCost   Float
  status      String
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId])
  @@index([facilityId])
  @@index([status])
}

model Customer {
  id          String   @id @default(cuid())
  userId      String   @unique
  stripeId    String   @unique
  email       String
  name        String
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId])
  @@index([stripeId])
}

model Plan {
  id          String   @id @default(cuid())
  name        String   @unique
  stripeId    String   @unique
  amount      Float
  currency    String   @default("USD")
  interval    String
  features    Json?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([stripeId])
}

model Subscription {
  id          String   @id @default(cuid())
  userId      String
  customerId  String
  planId      String
  stripeId    String   @unique
  status      String
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  
  // Relations
  protectionPlan ProtectionPlan? @relation(fields: [planId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId])
  @@index([customerId])
  @@index([planId])
  @@index([status])
}

model CardTransaction {
  id          String   @id @default(cuid())
  cardId      String
  amount      Float
  currency    String
  merchant    String?
  status      String
  stripeId    String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([cardId])
  @@index([status])
}

// ============================================================================
// ENUMS FOR ROCKEFELLER PROTECTION PLAN & HELOC
// ============================================================================

enum PlanType {
  STANDARD
  ENHANCED
  PREMIUM
}

enum PlanStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
  EXPIRED
}

// ============================================================================
// ROCKEFELLER PROTECTION PLAN - HOME PROTECTION WITH HELOC INTEGRATION
// ============================================================================

model ProtectionPlan {
  id              String   @id @default(cuid())
  userId          String   @unique
  referenceNumber String   @unique
  
  // Plan Details
  planType        PlanType @default(STANDARD)
  status          PlanStatus @default(ACTIVE)
  homeValue       Float
  monthlyExpenses Float
  
  // Coverage Details
  deathBenefit    Float
  monthlyPremium  Float
  coverageYears   Int      @default(50)
  
  // Trust Information
  trustName       String?
  trustEstablished DateTime?
  
  // HELOC Integration
  helocEnabled    Boolean  @default(true)
  helocMaxLTV     Float    @default(85.0)
  helocPreferredRate Float  @default(7.0)
  
  // Metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  user            User               @relation(fields: [userId], references: [id])
  helocApplications HELOCApplication[]
  helocAccounts     HELOCAccount[]
  subscriptions     Subscription[]
  
  @@index([userId])
  @@index([status])
  @@index([referenceNumber])
}

// ============================================================================
// HELOC INTEGRATION - HOME EQUITY LINE OF CREDIT
// ============================================================================

model HELOCApplication {
  id              String   @id @default(cuid())
  referenceNumber String   @unique
  protectionPlanId String
  userId          String
  
  // Application Details
  homeValue       Float
  requestedAmount Float
  maxLTV          Float    @default(85)
  interestRate    Float    @default(7.5)
  
  // Status Tracking
  status          HELOCStatus @default(PENDING)
  submittedAt     DateTime @default(now())
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  
  // Relations
  riskAssessment  HELOCRiskAssessment?
  account         HELOCAccount?
  protectionPlan  ProtectionPlan @relation(fields: [protectionPlanId], references: [id])
  user            User           @relation(fields: [userId], references: [id])
  
  // Metadata
  ipAddress       String?
  userAgent       String?
  documents       Json?     // Uploaded documents
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([protectionPlanId])
  @@index([userId])
  @@index([status])
  @@index([submittedAt])
}

model HELOCAccount {
  id                    String   @id @default(cuid())
  applicationId         String   @unique
  protectionPlanId      String
  userId                String
  
  // Credit Details
  creditLimit           Float
  outstandingBalance    Float    @default(0)
  availableCredit       Float
  interestRate          Float
  
  // Term Details
  drawPeriodEndDate     DateTime
  repaymentPeriodEndDate DateTime
  
  // Payment Information
  monthlyPayment        Float    @default(0)
  nextPaymentDue        DateTime
  lastPaymentDate       DateTime?
  
  // Status and Controls
  status                HELOCStatus @default(ACTIVE)
  trustProtectionEnabled Boolean @default(true)
  automaticPaymentEnabled Boolean @default(false)
  
  // Usage Tracking
  lastDrawDate          DateTime?
  totalDraws            Int      @default(0)
  totalPayments        Float    @default(0)
  
  // Relations
  application           HELOCApplication @relation(fields: [applicationId], references: [id])
  protectionPlan        ProtectionPlan @relation(fields: [protectionPlanId], references: [id])
  user                  User           @relation(fields: [userId], references: [id])
  draws                 HELOCDraw[]
  payments              HELOCRepayment[]
  notifications         HELOCNotification[]
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@index([applicationId])
  @@index([protectionPlanId])
  @@index([userId])
  @@index([status])
}

model HELOCDraw {
  id                String   @id @default(cuid())
  accountId         String
  applicationId     String
  
  // Draw Details
  amount            Float
  purpose           DrawPurpose
  description       String
  
  // Status Tracking
  status            DrawStatus @default(PENDING)
  requestedAt       DateTime @default(now())
  processedAt       DateTime?
  approvedBy        String?
  rejectionReason   String?
  
  // Compliance
  counselingRequired Boolean  @default(false)
  counselingCompleted Boolean @default(false)
  counselingDate    DateTime?
  
  // Documentation
  documents         Json?    // Supporting documents
  bankTransferId    String?  // Transfer tracking
  
  // Relations
  account           HELOCAccount @relation(fields: [accountId], references: [id])
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([accountId])
  @@index([status])
  @@index([requestedAt])
  @@index([purpose])
}

model HELOCRepayment {
  id              String   @id @default(cuid())
  accountId       String
  drawId          String?  // Optional: link to specific draw
  
  // Payment Details
  amount          Float
  type            RepaymentType
  paymentDate     DateTime
  
  // Payment Method
  method          PaymentMethod
  transactionId   String?  // Bank transaction ID
  
  // Trust Protection
  trustCovered     Boolean  @default(false)
  trustPaymentId  String?  // Reference for trust payments
  
  // Processing
  processedAt     DateTime @default(now())
  processedBy     String?
  
  // Relations
  account         HELOCAccount @relation(fields: [accountId], references: [id])
  
  createdAt       DateTime @default(now())
  
  @@index([accountId])
  @@index([paymentDate])
  @@index([type])
  @@index([method])
}

model HELOCRiskAssessment {
  id                String   @id @default(cuid())
  applicationId     String   @unique
  
  // Credit Assessment
  creditScore       Int
  debtToIncome      Float
  loanToValue       Float
  propertyValue     Float
  
  // Risk Evaluation
  marketRisk        RiskLevel @default(MEDIUM)
  borrowerRisk      RiskLevel @default(MEDIUM)
  overallRisk       RiskLevel @default(MEDIUM)
  
  // Recommendations
  recommendedLimit  Float
  recommendedRate   Float
  recommendedTerms  Json?    // Special terms and conditions
  
  // Conditions
  conditions        Json?    // Required conditions for approval
  restrictions      Json?    // Usage restrictions
  
  // Assessment Metadata
  assessmentModel   String   @default("ROCKEFELLER-V1")
  assessorId        String?
  assessmentDate    DateTime @default(now())
  
  // Relations
  application       HELOCApplication @relation(fields: [applicationId], references: [id])
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([applicationId])
  @@index([creditScore])
  @@index([overallRisk])
  @@index([assessmentDate])
}

model HELOCNotification {
  id            String   @id @default(cuid())
  accountId     String
  
  // Notification Details
  type          HELOCNotificationType
  title         String
  message       String
  priority      NotificationPriority @default(MEDIUM)
  
  // Status
  read          Boolean  @default(false)
  readAt        DateTime?
  
  // Delivery
  emailSent     Boolean  @default(false)
  smsSent       Boolean  @default(false)
  pushSent      Boolean  @default(false)
  
  // Action Required
  actionRequired Boolean  @default(false)
  actionUrl     String?
  actionBy      DateTime?
  
  // Relations
  account       HELOCAccount @relation(fields: [accountId], references: [id])
  
  createdAt     DateTime @default(now())
  
  @@index([accountId])
  @@index([type])
  @@index([read])
  @@index([priority])
  @@index([createdAt])
}

model HELOCSettings {
  id                    String   @id @default(cuid())
  
  // Interest Rates
  baseInterestRate      Float    @default(7.5)
  preferredRate         Float    @default(7.0)
  maxRate               Float    @default(15.0)
  
  // Loan-to-Value Limits
  maxLTV                Float    @default(80.0)
  preferredMaxLTV       Float    @default(85.0)
  
  // Fees
  setupFee              Float    @default(0.0)
  annualFee             Float    @default(0.0)
  lateFee               Float    @default(25.0)
  
  // Terms
  drawPeriodYears       Int      @default(15)
  repaymentPeriodYears  Int      @default(25)
  
  // Limits and Controls
  emergencyDrawLimit    Float    @default(25000.0)
  counselingThreshold   Float    @default(50000.0)
  monthlyDrawLimit      Float    @default(0.1) // 10% of credit limit
  
  // Risk Settings
  minCreditScore        Int      @default(680)
  maxDebtToIncome       Float    @default(0.43)
  maxLoanToValue        Float    @default(85.0)
  
  // Trust Protection
  trustProtectionEnabled Boolean @default(true)
  trustPaymentThreshold Float    @default(0.05) // 5% of monthly payment
  
  // System Settings
  active                Boolean  @default(true)
  version               String   @default("1.0")
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@index([active])
  @@index([version])
}

enum HELOCStatus {
  PENDING
  APPROVED
  ACTIVE
  SUSPENDED
  CLOSED
  REJECTED
}

enum DrawPurpose {
  EMERGENCY
  HOME_IMPROVEMENT
  EDUCATION
  MEDICAL
  BUSINESS
  INVESTMENT
  DEBT_CONSOLIDATION
  OTHER
}

enum DrawStatus {
  PENDING
  APPROVED
  PROCESSED
  REJECTED
  CANCELLED
}

enum RepaymentType {
  MINIMUM_PAYMENT
  INTEREST_ONLY
  PRINCIPAL_AND_INTEREST
  ADDITIONAL_PRINCIPAL
  TRUST_COVERED
}

enum PaymentMethod {
  AUTOMATIC_BANK_TRANSFER
  TRUST_PAYMENT
  MANUAL_PAYMENT
  ONLINE_PAYMENT
}

// ============================================================================
// WHOLE LIFE INSURANCE MODELS
// ============================================================================

model WholeLifePolicy {
  id              String   @id @default(cuid())
  policyNumber    String   @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  coverageAmount  Float
  premium         Float
  cashValue       Float    @default(0)
  deathBenefit    Float
  loanBalance     Float    @default(0)
  surrenderValue  Float    @default(0)
  paidUpAdditions Float    @default(0)
  dividends       Float    @default(0)
  interestRate    Float    @default(0.045) // 4.5% guaranteed
  
  status          PolicyStatus @default(ACTIVE)
  issueDate       DateTime @default(now())
  maturityDate    DateTime
  lastPremiumDate DateTime @default(now())
  
  // Relations
  beneficiaries   PolicyBeneficiary[]
  riders          PolicyRider[]
  cancelTransactions CancelTransaction[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([userId])
  @@index([policyNumber])
  @@index([status])
}

model PolicyBeneficiary {
  id              String   @id @default(cuid())
  policyId        String
  policy          WholeLifePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  
  name            String
  relationship    String
  percentage      Float
  contingent      Boolean  @default(false)
  dateOfBirth     DateTime
  contactInfo     String
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([policyId])
}

model PolicyRider {
  id              String   @id @default(cuid())
  policyId        String
  policy          WholeLifePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  
  type            RiderType
  premium         Float
  benefit         Float
  active          Boolean  @default(true)
  startDate       DateTime @default(now())
  endDate         DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([policyId])
}

model CancelTransaction {
  id              String   @id @default(cuid())
  policyId        String
  policy          WholeLifePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type            CancelationType
  amount          Float
  reason          String
  date            DateTime @default(now())
  profitFromCancelation Float
  riskReduction   Float
  approvedBy      String
  
  createdAt       DateTime @default(now())
  
  @@index([policyId])
  @@index([userId])
  @@index([type])
}

enum PolicyStatus {
  ACTIVE
  CANCELLED
  PAID_UP
  SURRENDERED
  SUSPENDED
}

enum RiderType {
  WAIVER_OF_PREMIUM
  ACCELERATED_DEATH_BENEFIT
  LONG_TERM_CARE
  DISABILITY_WAIVER
}

enum CancelationType {
  PREMIUM_CANCELLATION
  POLICY_CANCELLATION
  RIDER_CANCELLATION
  POLICY_LOAN_CANCELLATION
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum HELOCNotificationType {
  DRAW_APPROVED
  DRAW_PROCESSED
  PAYMENT_DUE
  PAYMENT_PROCESSED
  LIMIT_REACHED
  RATE_CHANGE
  ACCOUNT_SUSPENDED
  COUNSELING_REQUIRED
  TRUST_INTERVENTION
  DOCUMENTS_REQUIRED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Missing models for legacy code compatibility
model Currency {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  symbol      String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([code])
  @@index([isActive])
}

model ExchangeRate {
  id          String   @id @default(cuid())
  fromCurrency String
  toCurrency   String
  rate         Float
  source       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([fromCurrency, toCurrency])
  @@index([createdAt])
}
