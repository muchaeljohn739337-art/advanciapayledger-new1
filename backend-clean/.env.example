# ============================================
# MVP MODE & FEATURE FLAGS
# ============================================
# Set MVP_MODE=true to disable Redis-dependent features
MVP_MODE=false
ENABLE_REDIS=false
ENABLE_QUEUE=true
ENABLE_SOCIAL_MEDIA=true
ENABLE_AI_FEATURES=true
ENABLE_CRYPTO_FEATURES=true
ENABLE_WEB3_AUTH=true
ENABLE_VAULT=false
# ============================================
# SOCIAL MEDIA (Optional - for auto-posting)
# ============================================
# Twitter/X API
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
# LinkedIn API
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=urn:li:person:XXXXXX
# Facebook Graph API
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_DEFAULT_IMAGE_URL=
# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHANNEL_ID=
TELEGRAM_CHANNEL_USERNAME=
# WhatsApp Business API (Cloud API)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BROADCAST_NUMBER=

# ============================================
# ROCKEFELLER HELOC INTEGRATION
# ============================================
# HELOC Configuration
HELOC_ENABLED=true
HELOC_DEFAULT_RATE=7.5
HELOC_MAX_LTV=85
HELOC_PREFERRED_MAX_LTV=85
HELOC_EMERGENCY_LIMIT=25000
HELOC_COUNSELING_THRESHOLD=50000
HELOC_SETUP_FEE=0
HELOC_ANNUAL_FEE=0
HELOC_DRAW_PERIOD_YEARS=15
HELOC_REPAYMENT_PERIOD_YEARS=25

# HELOC Risk Settings
HELOC_MIN_CREDIT_SCORE=680
HELOC_MAX_DEBT_TO_INCOME=0.43
HELOC_TRUST_PROTECTION_ENABLED=true
HELOC_TRUST_PAYMENT_THRESHOLD=0.05

# HELOC External Services
HELOC_CREDIT_BUREAU_API_KEY=
HELOC_BANK_TRANSFER_API_KEY=
HELOC_DOCUMENT_STORAGE_BUCKET=rockefeller-heloc-docs

# Rockefeller Protection Plan
ROCKEFELLER_PLAN_ENABLED=true
ROCKEFELLER_TRUST_COMPANY=Rockefeller Trust Company
ROCKEFELLER_REFERENCE_PREFIX=123456789
