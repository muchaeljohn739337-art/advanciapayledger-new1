# ============================================
# ADVANCIA PAY LEDGER - Environment Template
# ============================================
# Copy this to .env.development or .env.production
# Update values according to your environment
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
PRODUCTION_FRONTEND_URL=https://advanciapayledger.com
# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/advancia_payledger
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/advancia_payledger
#
REDIS_URL=redis://localhost:6379
# ============================================
# MVP MODE & FEATURE FLAGS
# ============================================
# Set MVP_MODE=true to disable Redis-dependent features
MVP_MODE=false
ENABLE_REDIS=false
ENABLE_QUEUE=true
ENABLE_SOCIAL_MEDIA=true
ENABLE_AI_FEATURES=true
ENABLE_CRYPTO_FEATURES=true
ENABLE_WEB3_AUTH=true
ENABLE_VAULT=false
# ============================================
# SECURITY & AUTHENTICATION
# ============================================
JWT_SECRET=your-super-secure-jwt-secret-key-256-bits
SESSION_SECRET=your-super-secure-session-secret
API_KEY=your-api-key-change-in-production
MASTER_ENCRYPTION_KEY=your-32-byte-hex-encryption-key
ADMIN_API_KEY=your-admin-api-key
SUPER_ADMIN_KEY=your-super-admin-key
SYSTEM_ADMIN_KEY=your-system-admin-key
CORS_ORIGIN=http://localhost:3000
# ============================================
# GOOGLE OAUTH
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
# ============================================
# PAYMENT PROVIDERS
# ============================================
# Stripe (Credit Cards & Virtual Cards)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# NOWPayments (Crypto Deposits)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Cryptomus (Alternative)
CRYPTOMUS_API_KEY=
CRYPTOMUS_MERCHANT_ID=
# ============================================
# EMAIL SERVICE (Postmark Primary, SMTP Fallback)
# ============================================
# Professional Email Addresses (Cloudflare Email Routing)
EMAIL_FROM=noreply@advanciapayledger.com
EMAIL_SUPPORT=support@advanciapayledger.com
EMAIL_BILLING=billing@advanciapayledger.com
EMAIL_ADMIN=admin@advanciapayledger.com
EMAIL_LIVECHAT=livechat@advanciapayledger.com
EMAIL_INFO=info@advanciapayledger.com

# Postmark (Transactional Email Service)
POSTMARK_API_KEY=your_postmark_api_key_here
POSTMARK_SERVER_ID=your-server-id
POSTMARK_SERVER_TOKEN=your-postmark-server-token

# Email SMTP Details (used by services/emailService.ts)
EMAIL_PROVIDER=postmark
EMAIL_HOST=smtp.postmarkapp.com
EMAIL_PORT=587
EMAIL_USER=your-postmark-api-token
EMAIL_PASSWORD=your-postmark-api-token
EMAIL_SECURE=false

# SendGrid (Alternative - FREE tier: 100 emails/day)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Resend (Alternative)
RESEND_API_KEY=

# SMTP Fallback (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Zoho Mail (Alternative)
ZOHO_MAIL_USER=
ZOHO_MAIL_PASSWORD=
ZOHO_MAIL_APP_PASSWORD=
# ============================================
# WEB3 & BLOCKCHAIN
# ============================================
# For Development (Hardhat Local): http://127.0.0.1:8545
# For Production (Mainnet): https://ethereum.publicnode.com
ETH_PROVIDER_URL=http://127.0.0.1:8545
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
BSC_RPC_URL=https://bsc-dataseed1.binance.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ADMIN_WALLET_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
ADMIN_WALLET_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Hardhat Development (optional - uses default test mnemonic if not set)
HARDHAT_MNEMONIC=test test test test test test test test test test test junk
TREASURY_PRIVATE_KEY=0x...
# ============================================
# PUSH NOTIFICATIONS (Firebase Cloud Messaging)
# ============================================
# Get your Firebase service account JSON from:
# Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Paste the entire JSON as a single-line string below
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}'
# ============================================
# CLOUDFLARE CONFIGURATION
# ============================================
CLOUDFLARE_ENABLED=false
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
# ============================================
# OLLAMA CONFIGURATION (Local AI)
# ============================================
OLLAMA_ENDPOINT=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
# ============================================
# OPTIONAL SERVICES
# ============================================
DOCTOR_INVITE_CODE=ADVANCIA2025MEDBED
DEBUG=app:*
LOG_LEVEL=info
APP_VERSION=2.0.0
# Sentry (Error Tracking & Performance Monitoring)
SENTRY_DSN=https://f12a5919a099c9dabb6075f84f3a2011@o4510400768573440.ingest.us.sentry.io/4510686561632256
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here
SENTRY_RELEASE=advancia-backend@2.0.0
# Worker Mode
WORKER=false
# Public URL (for social media links)
PUBLIC_URL=https://advanciapayledger.com
# ============================================
# POSTMARK EMAIL SERVICE (Transactional)
# ============================================
POSTMARK_API_KEY=your-postmark-server-api-token
POSTMARK_SERVER_ID=your-server-id
# ============================================
# AI SERVICES - LOCAL ONLY
# ============================================
# Ollama (Local AI) - Recommended
OLLAMA_ENDPOINT=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b

# External AI Services - DISABLED FOR SECURITY
# Commented out to prevent external data access
