{
  "compilerOptions": {
    "target": "ES2022",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "noEmit": false,
    "esModuleInterop": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/components/*": ["./src/components/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/utils/*": ["./src/utils/*"]
    },
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.js"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts",
    "prisma/**/*",
    "scripts/**/*",
    "tests/**/*",
    "src/scripts/**/*",
    "src/services/blockchainListener.ts",
    "src/services/AdvancedRealityService.ts",
    "src/services/CancelMoneyService.ts",
    "src/services/RobotDesignService.ts",
    "src/creator-sovereign-server.ts",
    "src/middleware/text-agent-auth.middleware.ts",
    "src/routes/advancedReality.ts",
    "src/routes/ai-auth.routes.ts",
    "src/routes/model-download.routes.ts",
    "src/routes/route-testing.routes.ts"
  ]
}
